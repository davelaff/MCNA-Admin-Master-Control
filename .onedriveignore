# .onedriveignore — mcna-tenant-intel
# Excludes dev artifacts from OneDrive sync / SharePoint.

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Python packaging
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Test/tool caches
.pytest_cache/
.mypy_cache/

# Secrets (safety net — .env lives outside this folder already)
*.env
*.pfx
*.pem
*.key
